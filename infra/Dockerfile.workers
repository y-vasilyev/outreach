FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl
ENV PNPM_HOME=/usr/local/share/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app
COPY pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/workers/package.json apps/workers/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY packages/llm/package.json packages/llm/
COPY packages/platforms/package.json packages/platforms/
COPY packages/storage/package.json packages/storage/
COPY packages/tg-client/package.json packages/tg-client/
COPY packages/agents/package.json packages/agents/
RUN pnpm install --frozen-lockfile=false

COPY packages packages
COPY apps/workers apps/workers
RUN pnpm --filter @nosquare/db prisma:generate

# See Dockerfile.api for why we bypass `pnpm start` (start script's
# --env-file=../../.env errors when the file is missing; in k8s env
# comes from envFrom, not a baked-in dotfile).
CMD ["pnpm", "--filter", "@nosquare/workers", "exec", "tsx", "src/index.ts"]
