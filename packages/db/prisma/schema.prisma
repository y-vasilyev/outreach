// Prisma schema for Nosquare Outreach
//
// Naming convention: Prisma model + field identifiers stay PascalCase /
// camelCase (so the generated TS client reads naturally), but every
// model/enum has @@map and every camelCase field has @map so that the
// actual Postgres tables, columns, and enum types are snake_case. That
// keeps hand-written SQL (psql, dbeaver, ad-hoc queries) free of the
// double-quote ceremony Postgres requires for mixed-case identifiers.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============== ENUMS ===============

enum UserRole {
  admin
  operator
  viewer

  @@map("user_role")
}

enum Platform {
  telegram
  instagram
  youtube

  @@map("platform")
}

enum TgAccountStatus {
  idle
  active
  cooldown
  banned
  need_auth

  @@map("tg_account_status")
}

enum TgAccountRole {
  parser
  outreach
  both

  @@map("tg_account_role")
}

enum LLMProviderKind {
  yandex
  openrouter
  openai_compat

  @@map("llm_provider_kind")
}

enum ChannelStatus {
  new
  scraping
  scraped
  extracting
  extracted
  ready
  done
  failed

  @@map("channel_status")
}

enum ContactType {
  tg_username
  tg_phone
  tg_link
  email
  website
  web_form
  other
  bot

  @@map("contact_type")
}

enum RoleGuess {
  owner
  ad_manager
  generic
  bot
  unknown

  @@map("role_guess")
}

enum Reachability {
  reachable_tg
  manual
  unreachable

  @@map("reachability")
}

enum ContactStatus {
  new
  qualified
  disqualified
  contacted
  active
  finished
  invalid
  blocked

  @@map("contact_status")
}

enum ExtractedBy {
  regex
  llm
  both
  // Operator hand-edited the contact (role / confidence / value).
  // The contact-extract worker checks this and skips overwriting on re-run.
  manual

  @@map("extracted_by")
}

enum CampaignStatus {
  draft
  running
  paused
  finished

  @@map("campaign_status")
}

enum ConversationMode {
  auto
  semi_auto
  assisted
  manual

  @@map("conversation_mode")
}

enum ConversationStatus {
  active
  paused
  done
  failed
  // Operator parked an off-target ("нецелевка") chat out of the working
  // inbox. Reversible (→ active); hidden from the default inbox list but
  // reachable via the status filter. Appended last → additive enum ADD VALUE.
  archived

  @@map("conversation_status")
}

enum MessageDirection {
  in_
  out_

  @@map("message_direction")
}

enum MessageSender {
  contact
  ai
  operator
  system

  @@map("message_sender")
}

enum MessageStatus {
  pending
  sending
  sent
  failed
  received

  @@map("message_status")
}

enum SuggestionStatus {
  pending
  approved
  edited
  rejected
  sent
  expired

  @@map("suggestion_status")
}

enum AgentRunStatus {
  ok
  fallback
  failed

  @@map("agent_run_status")
}

// =============== MODELS ===============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(operator)
  settings     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  channelsAdded         Channel[]            @relation("ChannelAddedBy")
  conversationsAssigned Conversation[]       @relation("ConversationOperator")
  messages              Message[]
  campaigns             Campaign[]
  agentConfigsUpdated   AgentConfig[]        @relation("AgentConfigUpdatedBy")
  agentConfigHistories  AgentConfigHistory[] @relation("AgentConfigHistoryChangedBy")
  auditLogs             AuditLog[]

  @@map("user")
}

// Per-account RPM caps live in `parserRpm` / `outreachRpm` (see TgAccount).
// They model the proactive worker-side throttle that keeps a single account
// from hammering TG fast enough to trip FloodWait — separate from the daily
// counters which are about long-window outreach quotas.

model TgAccount {
  id                   String          @id @default(cuid())
  label                String
  phone                String          @unique
  sessionEncrypted     String?         @map("session_encrypted")
  status               TgAccountStatus @default(need_auth)
  role                 TgAccountRole   @default(both)
  dailyMsgLimit        Int             @default(30) @map("daily_msg_limit")
  dailyNewContactLimit Int             @default(15) @map("daily_new_contact_limit")
  // Per-account requests-per-minute caps used by the worker-side role rate
  // limiter. Nullable = unlimited (env defaults TG_PARSER_RPM /
  // TG_OUTREACH_RPM still apply as the global fallback when these are null).
  // Operator sets these per account in the inbox UI.
  parserRpm            Int?            @map("parser_rpm")
  outreachRpm          Int?            @map("outreach_rpm")
  sentTodayMsg         Int             @default(0) @map("sent_today_msg")
  sentTodayNew         Int             @default(0) @map("sent_today_new")
  dayRolledAt          DateTime?       @map("day_rolled_at")
  cooldownUntil        DateTime?       @map("cooldown_until")
  warmupStartedAt      DateTime?       @map("warmup_started_at")
  warmupStage          Int             @default(0) @map("warmup_stage")
  tags                 String[]        @default([])
  notes                String?
  loginPhoneCodeHash   String?         @map("login_phone_code_hash")
  deviceFingerprint    Json?           @map("device_fingerprint")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  conversations Conversation[]
  opLogs        TgOpLog[]

  @@map("tg_account")
}

model Integration {
  id              String    @id @default(cuid())
  kind            String    @unique
  configEncrypted String    @map("config_encrypted")
  enabled         Boolean   @default(true)
  status          String?
  lastCheckAt     DateTime? @map("last_check_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("integration")
}

model Endpoint {
  id             String          @id @default(cuid())
  name           String          @unique
  provider       LLMProviderKind
  baseUrl        String          @map("base_url")
  authEncrypted  String          @map("auth_encrypted")
  defaultHeaders Json            @default("{}") @map("default_headers")
  rateLimitRpm   Int?            @map("rate_limit_rpm")
  enabled        Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  agentConfigsPrimary  AgentConfig[] @relation("AgentEndpointPrimary")
  agentConfigsFallback AgentConfig[] @relation("AgentEndpointFallback")
  agentRuns            AgentRun[]

  @@map("endpoint")
}

model Channel {
  id          String        @id @default(cuid())
  platform    Platform
  externalId  String?       @map("external_id")
  handle      String
  title       String?
  description String?
  links       String[]      @default([])
  followers   Int?
  language    String?
  rawData     Json?         @map("raw_data")
  analysis    Json?
  status      ChannelStatus @default(new)
  source      String        @default("manual")
  addedById   String?       @map("added_by_id")
  addedBy     User?         @relation("ChannelAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  scrapedAt   DateTime?     @map("scraped_at")
  lastError   String?       @map("last_error")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  contacts  Contact[]
  agentRuns AgentRun[]

  @@unique([platform, externalId])
  @@unique([platform, handle])
  @@index([status])
  @@map("channel")
}

model Contact {
  id           String        @id @default(cuid())
  // Optional so the operator can paste cold leads that don't belong to a
  // tracked channel. Cold-lead dedupe is handled by a partial unique index
  // `(type, value) WHERE channel_id IS NULL` recreated below.
  channelId    String?       @map("channel_id")
  channel      Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  type         ContactType
  value        String
  rawValue     String        @map("raw_value")
  label        String?
  roleGuess    RoleGuess     @default(unknown) @map("role_guess")
  confidence   Decimal       @default(0)
  extractedBy  ExtractedBy   @default(regex) @map("extracted_by")
  reachability Reachability  @default(manual)
  status       ContactStatus @default(new)
  tags         String[]      @default([])
  tgUserId     String?       @map("tg_user_id")
  // GramJS access_hash captured off the inline sender entity on each inbound,
  // or off the resolved user on outbound. Lets us build an explicit
  // InputPeerUser when the session-level entity cache doesn't have it (the
  // "Could not find the input entity" failure mode on cold sync / read-ack).
  tgAccessHash String?       @map("tg_access_hash")
  // Resolved on the first outbound send (via TgClient.resolveUser). Stored
  // so the opener / reply pipelines can address the recipient by name and
  // so the tg-listen worker can match incoming messages back to the contact.
  tgUsername   String?       @map("tg_username")
  tgFirstName  String?       @map("tg_first_name")
  tgLastName   String?       @map("tg_last_name")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  conversations Conversation[]
  agentRuns     AgentRun[]

  @@unique([channelId, type, value])
  @@index([status, reachability])
  @@map("contact")
}

model Campaign {
  id                  String           @id @default(cuid())
  name                String
  goalText            String           @map("goal_text")
  valueProp           String           @map("value_prop")
  // Campaign type from the registry (agency-sourcing-matching change).
  typeId              String           @map("type_id")
  type                CampaignType     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  // Structured goal validated against the type's `goalSchema`.
  goal                Json?
  targetFilter        Json             @default("{}") @map("target_filter")
  agentOverrides      Json             @default("{}") @map("agent_overrides")
  outreachAccountPool String[]         @default([]) @map("outreach_account_pool")
  schedule            Json             @default("{}")
  defaultMode         ConversationMode @default(assisted) @map("default_mode")
  status              CampaignStatus   @default(draft)
  createdById         String?          @map("created_by_id")
  createdBy           User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  conversations Conversation[]

  @@index([typeId])
  @@map("campaign")
}

model Conversation {
  id                 String             @id @default(cuid())
  tgAccountId        String             @map("tg_account_id")
  tgAccount          TgAccount          @relation(fields: [tgAccountId], references: [id])
  contactId          String             @map("contact_id")
  contact            Contact            @relation(fields: [contactId], references: [id])
  campaignId         String?            @map("campaign_id")
  campaign           Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  status             ConversationStatus @default(active)
  mode               ConversationMode   @default(assisted)
  assignedOperatorId String?            @map("assigned_operator_id")
  assignedOperator   User?              @relation("ConversationOperator", fields: [assignedOperatorId], references: [id], onDelete: SetNull)
  lastInboundAt      DateTime?          @map("last_inbound_at")
  lastOutboundAt     DateTime?          @map("last_outbound_at")
  // When the operator last acked this conversation (UI open or new-inbound).
  // Same timestamp drives the TG `messages.ReadHistory` call AND the local
  // "you read at HH:MM" indicator in the inbox.
  lastReadAt         DateTime?          @map("last_read_at")
  // Latest GoalFitEvaluator gate snapshot for `semi_auto`/`auto` mode.
  qualityDecision    Json?              @map("quality_decision")
  // Updated whenever the API on-open sync successfully fetches history.
  lastSyncedAt       DateTime?          @map("last_synced_at")
  summary            String?
  meta               Json               @default("{}")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  messages    Message[]
  suggestions Suggestion[]
  agentRuns   AgentRun[]

  @@unique([tgAccountId, contactId])
  @@index([lastInboundAt])
  @@map("conversation")
}

model Message {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tgMsgId        String?          @map("tg_msg_id")
  direction      MessageDirection
  sender         MessageSender
  text           String
  attachments    Json             @default("[]")
  status         MessageStatus    @default(pending)
  suggestionId   String?          @map("suggestion_id")
  suggestion     Suggestion?      @relation(fields: [suggestionId], references: [id], onDelete: SetNull)
  operatorId     String?          @map("operator_id")
  operator       User?            @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  sentAt         DateTime?        @map("sent_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  // Stable variantKey identifying which opener variant was sent. Populated
  // only for outbound messages whose source `Suggestion.agentName` is
  // `opening_composer` or `agency_opening_composer`; drives per-variant
  // sent/replied/replyRate aggregates served by /campaigns/:id/opener-stats.
  openerVariant  String?          @map("opener_variant")
  mediaAssets    MediaAsset[]

  @@index([conversationId, createdAt])
  @@index([conversationId, openerVariant])
  @@map("message")
}

model Suggestion {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentName      String           @map("agent_name")
  text           String
  rationale      String           @default("")
  score          Decimal          @default(0)
  status         SuggestionStatus @default(pending)
  meta           Json             @default("{}")
  createdAt      DateTime         @default(now()) @map("created_at")
  expiresAt      DateTime?        @map("expires_at")

  messages Message[]

  @@index([conversationId, status])
  @@map("suggestion")
}

model AgentConfig {
  id                 String    @id @default(cuid())
  name               String    @unique
  role               String    @default("")
  description        String    @default("")
  endpointId         String?   @map("endpoint_id")
  endpoint           Endpoint? @relation("AgentEndpointPrimary", fields: [endpointId], references: [id], onDelete: SetNull)
  fallbackEndpointId String?   @map("fallback_endpoint_id")
  fallbackEndpoint   Endpoint? @relation("AgentEndpointFallback", fields: [fallbackEndpointId], references: [id], onDelete: SetNull)
  model              String    @default("")
  systemPrompt       String    @default("") @map("system_prompt")
  userPromptTemplate String    @default("") @map("user_prompt_template")
  params             Json      @default("{}")
  enabled            Boolean   @default(true)
  version            Int       @default(1)
  updatedById        String?   @map("updated_by_id")
  updatedBy          User?     @relation("AgentConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  history AgentConfigHistory[]

  @@map("agent_config")
}

model AgentConfigHistory {
  id            String      @id @default(cuid())
  agentConfigId String      @map("agent_config_id")
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  changedById   String?     @map("changed_by_id")
  changedBy     User?       @relation("AgentConfigHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt     DateTime    @default(now()) @map("changed_at")

  @@map("agent_config_history")
}

model AgentRun {
  id             String         @id @default(cuid())
  agentName      String         @map("agent_name")
  channelId      String?        @map("channel_id")
  channel        Channel?       @relation(fields: [channelId], references: [id], onDelete: SetNull)
  contactId      String?        @map("contact_id")
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversationId String?        @map("conversation_id")
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  endpointId     String?        @map("endpoint_id")
  endpoint       Endpoint?      @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  model          String?
  input          Json
  output         Json?
  tokensIn       Int            @default(0) @map("tokens_in")
  tokensOut      Int            @default(0) @map("tokens_out")
  costUsd        Decimal        @default(0) @map("cost_usd")
  latencyMs      Int            @default(0) @map("latency_ms")
  status         AgentRunStatus @default(ok)
  error          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([agentName, createdAt])
  @@map("agent_run")
}

model TgOpLog {
  id          String    @id @default(cuid())
  tgAccountId String    @map("tg_account_id")
  tgAccount   TgAccount @relation(fields: [tgAccountId], references: [id], onDelete: Cascade)
  op          String
  ok          Boolean
  latencyMs   Int       @default(0) @map("latency_ms")
  error       String?
  meta        Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tgAccountId, createdAt])
  @@map("tg_op_log")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_log")
}

// =============== AGENCY SOURCING & MATCHING ===============
// (agency-sourcing-matching change)

enum MediaAssetKind {
  media_kit
  screenshot
  document
  image
  video
  raw_payload
  other

  @@map("media_asset_kind")
}

// Configurable campaign type. Drives which agents run, the safety profile
// (allowed/forbidden vocabulary), the autonomy policy, and the JSON-schema
// a campaign's `goal` is validated against.
model CampaignType {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String   @default("")
  goalSchema     Json     @default("{}") @map("goal_schema")
  agentSet       Json     @default("{}") @map("agent_set")
  safetyProfile  Json     @default("{}") @map("safety_profile")
  autonomyPolicy Json     @default("{}") @map("autonomy_policy")
  builtIn        Boolean  @default(false) @map("built_in")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  campaigns Campaign[]

  @@map("campaign_type")
}

// Runtime feature flag (runtime-feature-flags change). Source of truth for
// operational rollout/kill switches; toggled from the admin UI, cached in
// each process and invalidated via Redis pub/sub. `updatedById` is a plain
// column (the actor + change are also recorded in audit_log).
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String   @default("")
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("feature_flag")
}

// Batch channel discovery (batch-channel-discovery change). One row per
// async batch request: stores the input niches + accumulated per-niche
// results so the worker can iterate, the API can poll status, and the
// operator can come back to a long-running batch hours later.
enum DiscoveryBatchStatus {
  pending
  running
  done
  failed

  @@map("discovery_batch_status")
}

model DiscoveryBatch {
  id            String               @id @default(cuid())
  // The niches submitted by the operator. Stored as JSON so a future worker
  // can re-process a subset or annotate progress per-entry.
  queries       Json
  // Optional platform filter (null = all platforms). Mirrors the single-search
  // input shape.
  platform      String?
  limitPerQuery Int                  @default(20) @map("limit_per_query")
  status        DiscoveryBatchStatus @default(pending)
  // Accumulated result: per-niche records + totals. Worker updates on each
  // iteration. Shape mirrors `DiscoveryBatchSummaryZ` in `@nosquare/shared`.
  summary       Json                 @default("{}")
  createdById   String?              @map("created_by_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  completedAt   DateTime?            @map("completed_at")

  @@index([status, createdAt])
  @@index([createdById])
  @@map("discovery_batch")
}

// Guided blogger discovery (ajtbd-guided-blogger-discovery change). A
// first-class run with richer lifecycle data than DiscoveryBatch: the
// campaign/manual AJTBD-brief input snapshot, the LLM query plan, a
// sanitized operator-visible trace, and enriched reviewable candidates.
// Trace events are stored as JSON on the run (a product surface, D4); the
// candidates are a separate table so save/shortlist/reject + scrape-refresh
// can be persisted per-candidate without rewriting the whole run blob.
enum DiscoveryRunStatus {
  pending
  running
  done
  failed

  @@map("discovery_run_status")
}

model DiscoveryRun {
  id             String             @id @default(cuid())
  // Optional campaign whose goal/AJTBD seeded this run (null for a manual
  // brief). Plain reference (no FK) so a deleted campaign doesn't cascade
  // into discovery history.
  campaignId     String?            @map("campaign_id")
  // Stable input snapshot resolved before any agent/search work. Shape
  // mirrors `GuidedRunInputZ` in @nosquare/shared: { brief, ajtbd, platform,
  // geo, language, budgets }.
  input          Json
  status         DiscoveryRunStatus @default(pending)
  // Planner output: the bounded set of planned queries (sanitized). Shape
  // mirrors `PlannedQueryZ[]`.
  plannedQueries Json               @default("[]") @map("planned_queries")
  // Sanitized operator-visible trace events. Shape mirrors
  // `DiscoveryTraceEventZ[]`. Never contains API keys / raw integration
  // config / private payloads.
  trace          Json               @default("[]")
  // Run summary: budget usage, counts, skipped, fatalError. Shape mirrors
  // `GuidedRunSummaryZ`.
  summary        Json               @default("{}")
  createdById    String?            @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  completedAt    DateTime?          @map("completed_at")

  candidates DiscoveryRunCandidate[]

  @@index([status, createdAt])
  @@index([createdById])
  @@map("discovery_run")
}

model DiscoveryRunCandidate {
  id               String       @id @default(cuid())
  runId            String       @map("run_id")
  run              DiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Plain reference to the created/reused Channel.id (no FK relation, keeping
  // the channel graph's cascade semantics untouched). Null only transiently
  // before the channel row is upserted.
  channelId        String?      @map("channel_id")
  platform         String
  handle           String
  // Provenance (channel-discovery spec): { sourceQueries[], url, title,
  // alreadyKnown }.
  provenance       Json         @default("{}")
  // Enrichment lifecycle: new | needs_scrape | pending_enrichment | enriched.
  enrichmentStatus String       @default("new") @map("enrichment_status")
  // Reviewer output: { recommendation, rationale, riskNotes[], evidence[],
  // insufficientEvidenceReason? }. Null until reviewed (or skipped).
  review           Json?
  // Denormalised reviewer score (0..1) for list ordering; null until reviewed.
  score            Decimal?
  // Denormalised recommendation enum for compact list rows.
  recommendation   String?
  // Operator decision: null | saved | shortlisted | rejected.
  decision         String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@unique([runId, platform, handle])
  @@index([runId])
  @@map("discovery_run_candidate")
}

// Standardized, queryable catalog row for a blogger/channel. Composed
// deterministically from ProfileDataPoint rows (latest high-confidence).
model BloggerProfile {
  id         String    @id @default(cuid())
  // Plain indexed reference to Channel.id (no FK relation to keep the
  // existing channel graph's cascade semantics untouched).
  channelId  String?   @unique @map("channel_id")
  topics     String[]  @default([])
  languages  String[]  @default([])
  formats    String[]  @default([])
  // Standardized rolled-up fields: { reach, avgViews, rateCards: [...],
  // audience: { age, gender, geo } }. Source of truth is dataPoints.
  audience   Json      @default("{}")
  rateCards  Json      @default("[]") @map("rate_cards")
  // Structured placement offers (entity-style-rate-cards). Rolled up from
  // `placement.offer` ProfileDataPoint rows; `rateCards`/`formats` are derived
  // from these for compatibility. Shape mirrors `PlacementOfferZ[]` in shared.
  placementOffers Json @default("[]") @map("placement_offers")
  reach      Int?
  avgViews   Int?      @map("avg_views")
  capturedAt DateTime? @map("captured_at")
  postInsightRefreshStatus String   @default("idle") @map("post_insight_refresh_status")
  postInsightRefreshError  String?  @map("post_insight_refresh_error")
  postInsightRefreshedAt   DateTime? @map("post_insight_refreshed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  dataPoints   ProfileDataPoint[]
  mediaAssets  MediaAsset[]
  matchResults MatchResult[]
  postInsights BloggerPostInsight[]

  @@map("blogger_profile")
}

// Public post evidence for catalog relevance/top-post previews. Source data is
// public channel/post data from ScrapeCreators or Telegram public parsing; raw
// upstream payloads are not exposed through APIs.
model BloggerPostInsight {
  id               String         @id @default(cuid())
  profileId        String         @map("profile_id")
  profile          BloggerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  // Plain reference to Channel.id; no FK to preserve the existing channel graph
  // cascade semantics.
  channelId        String?        @map("channel_id")
  platform         String
  externalPostId   String         @map("external_post_id")
  url              String?
  publishedAt      DateTime?      @map("published_at")
  textSnippet      String         @default("") @map("text_snippet")
  mediaKind        String         @default("post") @map("media_kind")
  metrics          Json           @default("{}")
  metricCapturedAt DateTime?      @map("metric_captured_at")
  source           String
  sourceRawRef     String?        @map("source_raw_ref")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([profileId, platform, externalPostId])
  @@index([profileId, publishedAt])
  @@index([channelId])
  @@map("blogger_post_insight")
}

// One harvested fact with provenance, so the rolled-up profile can be
// re-derived and audited. Raw source text preserved in `rawSnippet`.
model ProfileDataPoint {
  id              String         @id @default(cuid())
  profileId       String         @map("profile_id")
  profile         BloggerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  field           String
  value           Json
  unit            String?
  confidence      Decimal        @default(0)
  extractedBy     String         @default("llm") @map("extracted_by")
  // Plain reference to Message.id (no FK relation).
  sourceMessageId String?        @map("source_message_id")
  rawSnippet      String         @default("") @map("raw_snippet")
  capturedAt      DateTime       @default(now()) @map("captured_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([profileId, field])
  @@map("profile_data_point")
}

// Placement attribute registry + LLM proposals (entity-style-rate-cards).
// One row per attribute key. `status=active` rows form the active registry
// (seeded from PLACEMENT_ATTRIBUTE_REGISTRY_V1 + operator-approved proposals).
// `status=proposed` rows are inactive drafts emitted by extraction, surfaced
// for operator review; approval flips them to `active`. The shared v1 constant
// is the seed source + fallback when this table is empty.
model PlacementAttribute {
  id              String   @id @default(cuid())
  key             String
  // 'string' | 'number' | 'boolean' | 'enum' | 'string_list'
  valueType       String   @map("value_type")
  description     String   @default("")
  applicableKinds String[] @default([]) @map("applicable_kinds")
  enumValues      String[] @default([]) @map("enum_values")
  requiredForKinds String[] @default([]) @map("required_for_kinds")
  // 'active' | 'proposed' | 'rejected'
  status          String   @default("proposed")
  // Proposal provenance + review metadata (empty for seeded active rows).
  evidence        Json     @default("[]")
  confidence      Decimal  @default(0)
  rationale       String   @default("")
  sourceMessageId String?  @map("source_message_id")
  proposedByRunId String?  @map("proposed_by_run_id")
  reviewedById    String?  @map("reviewed_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([key, status])
  @@map("placement_attribute")
}

// Files bloggers send (media kits, stat screenshots) and raw payload
// snapshots, stored in S3-compatible object storage.
model MediaAsset {
  id             String          @id @default(cuid())
  // Plain indexed reference to Conversation.id.
  conversationId String?         @map("conversation_id")
  // Owning chat Message, when this asset was attached to an inbound message.
  // SetNull on Message delete keeps the asset row queryable for backfill/audit.
  messageId      String?         @map("message_id")
  message        Message?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  profileId      String?         @map("profile_id")
  profile        BloggerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  kind           MediaAssetKind  @default(other)
  s3Key          String          @map("s3_key")
  mime           String?
  bytes          Int?
  sha256         String?
  // Plain reference to the source TG message id.
  sourceTgMsgId  String?         @map("source_tg_msg_id")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([messageId])
  @@index([profileId])
  @@map("media_asset")
}

// Incoming advertising request to match against the catalog.
model AdBrief {
  id             String    @id @default(cuid())
  topic          String
  audienceTarget String    @default("") @map("audience_target")
  budget         Int?
  formats        String[]  @default([])
  geo            String[]  @default([])
  deadline       DateTime?
  notes          String    @default("")
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  matchResults MatchResult[]

  @@map("ad_brief")
}

// A ranked candidate for a brief, persisted for auditability.
model MatchResult {
  id            String         @id @default(cuid())
  briefId       String         @map("brief_id")
  brief         AdBrief        @relation(fields: [briefId], references: [id], onDelete: Cascade)
  profileId     String         @map("profile_id")
  profile       BloggerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  score         Decimal        @default(0)
  rationale     String         @default("")
  rerankedByLlm Boolean        @default(false) @map("reranked_by_llm")
  fitSignals    Json           @default("{}") @map("fit_signals")
  evidencePostIds String[]     @default([]) @map("evidence_post_ids")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([briefId])
  @@index([profileId])
  @@map("match_result")
}
